{
  "restly": 1,
  "id": "demo",
  "name": "Demo API",
  "variables": [{"key": "token", "value": "from-collection", "enabled": true}],
  "auth": {"type": "bearer", "bearer": "{{token}}"},
  "children": [
    {
      "type": "folder",
      "id": "folder-users",
      "name": "Users",
      "children": [
        {
          "type": "request",
          "id": "req-users",
          "name": "List users",
          "method": "GET",
          "url": "{{baseUrl}}/users?page=2"
        }
      ]
    }
  ]
}
